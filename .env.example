# ── Portas (cada processo tem a sua; o Vite usa strictPort e falha se estiver ocupada) ──
API_PORT=3100
HUB_PORT=5180
DEMO_PORT=5181
DEMO_API_PORT=4100
POSTGRES_PORT=5433

# ── URLs ──
HUB_URL=http://localhost:5180
# Só variáveis com prefixo VITE_ chegam ao navegador. NUNCA coloque segredo com VITE_.
VITE_HUB_URL=http://localhost:5180

# ── Banco (a porta precisa bater com POSTGRES_PORT) ──
DATABASE_URL=postgresql://sondohub:sondohub@localhost:5433/sondohub?schema=public

# ── Sessão (produção: __Host-sondohub_session e COOKIE_SECURE=true) ──
SESSION_COOKIE_NAME=sondohub_session
COOKIE_SECURE=false

# ── JWT (aula 05: gere com  pnpm --filter api exec node scripts/generate-jwt-key.ts) ──
JWT_KEY_ID=
JWT_PRIVATE_KEY=

# ── Seed (só dev): senha dos usuários de teste criados pelo seed ──
SEED_ADMIN_EMAIL=admin@sondotecnica.com.br
SEED_PASSWORD=troque-esta-senha

# --- AWS BLOB STORE
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# ── Gêmeo Digital: chave que o gds-techlab espera no x-api-key (é o SONDOHUB_API_KEY do .env dele) ──
GDS_APY_KEY=
GEMEO_API_URL=http://localhost:3030

# ── Experience: API dele (com /api) e a chave do painel (Chaves de API, sk_sondo_...); lá ela é o SONDOHUB_API_KEY ──
EXPERIENCE_API_URL=
EXPERIENCE_API_KEY=

# ── E-mail SMTP (Microsoft 365) ──
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notificacoes.app@sondotecnica.com.br
SMTP_PASS=
SMTP_FROM="SondoHub <notificacoes.app@sondotecnica.com.br>"

# ── Assistente de IA (voz e chat) ──
# Segredo que criptografa as chaves do Gemini no banco (mín. 32 caracteres aleatórios; trocar invalida as chaves salvas).
# Sem ele o assistente fica desligado (503). A chave do Gemini em si NÃO vai aqui: o Master cadastra em /admin/assistente.
# ASSISTENTE_CHAVE_SECRETA=
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# GEMINI_SEARCH_MODEL=gemini-3.8-flash
