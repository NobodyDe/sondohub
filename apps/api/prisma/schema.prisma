// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  name             String
  passwordHash     String?   @map("password_hash")
  avatarUrl        String?   @map("avatar_url")
  role             UserRole  @default(USER)   
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  access   UserAppAccess[]
  sessions Session[]
  events   AppEvent[]
  passwordResetCode PasswordResetCode?
  apiKeys  ApiKey[]
  assistentePermissao AssistentePermissao?
  assistentePreferencias AssistentePreferencias?
  assistenteChave AssistenteChaveUsuario?
  assistenteRegras AssistenteRegra[]
  assistenteMemorias AssistenteMemoria[]
  assistentePerguntas AssistentePergunta[]
  assistenteAuditoria AssistenteAuditoria[]

  @@map("users")
}

model Application {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  description String   @db.VarChar(144)
  iconUrl   String   @map("icon_url")
  url       String
  origin    String   @unique
  levels    Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  access UserAppAccess[]
  events AppEvent[]

  @@map("applications")
}

model UserAppAccess {
  userId        String   @map("user_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  level         Int
  grantedAt     DateTime @default(now()) @map("granted_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([userId, applicationId])
  @@index([applicationId])
  @@index([grantedAt]) // painel: inclusões por período
  @@map("user_app_access")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt]) // painel: logins por período
  @@map("sessions")
}

/// Chave de API de um usuário. O segredo não fica aqui: só o SHA-256 (key_hash) e um trecho para a tela (hint).
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @db.VarChar(60)
  keyHash    String    @unique @map("key_hash")
  hint       String
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at") // null = nunca expira (só MASTER cria)
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

/// Código de redefinição de senha: um por usuário, vale 5 minutos.
model PasswordResetCode {
  userId    String   @id @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

/// Uso dos apps: OPEN = uma visita (renovações de token dentro de 30 min só avançam lastSeenAt); CLICK = clique no launcher do hub.
model AppEvent {
  id            BigInt       @id @default(autoincrement())
  userId        String       @map("user_id") @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  type          AppEventType
  createdAt     DateTime     @default(now()) @map("created_at")
  lastSeenAt    DateTime     @default(now()) @map("last_seen_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([userId, createdAt])
  @@map("app_events")
}

enum AppEventType {
  OPEN
  CLICK
}

enum UserRole {
  MASTER
  ADMIN
  USER
}

// ── Assistente de IA (voz e chat). Tabelas próprias; nenhuma tabela de negócio é alterada. ──

/// Linha única (id = 1): a chave do Gemini da empresa, criptografada pela aplicação (AES-256-GCM). Nunca volta à API em claro.
model AssistenteConfig {
  id         Int      @id @default(1) @db.SmallInt
  apiKeyEnc  String?  @map("api_key_enc")
  updatedAt  DateTime @default(now()) @map("updated_at")
  updatedBy  String?  @map("updated_by") @db.Uuid

  @@map("assistente_config")
}

/// Chave do Gemini própria do usuário (vale no lugar da global).
model AssistenteChaveUsuario {
  userId    String   @id @map("user_id") @db.Uuid
  apiKeyEnc String   @map("api_key_enc")
  updatedAt DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assistente_chaves_usuario")
}

/// Preferências de cada usuário.
model AssistentePreferencias {
  userId      String   @id @map("user_id") @db.Uuid
  habilitado  Boolean  @default(false)
  voz         String   @default("Charon") // 'Charon' (masculina) | 'Kore' (feminina)
  internet    Boolean  @default(false)
  nome        String   @default("") // nome do assistente; vazio = ele pergunta
  apelido     String   @default("") // como chamar a pessoa; vazio = primeiro nome
  modoMic     String   @default("aberto") @map("modo_mic") // 'aberto' | 'apertar'
  chatTexto   Boolean  @default(true) @map("chat_texto")
  preferencia String   @default("voz") // 'voz' | 'texto'
  updatedAt   DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assistente_usuario")
}

/// O Master libera o assistente de cada pessoa. Tabela própria: `users` não leva coluna nova.
model AssistentePermissao {
  userId     String   @id @map("user_id") @db.Uuid
  autorizado Boolean  @default(false)
  updatedBy  String?  @map("updated_by") @db.Uuid
  updatedAt  DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assistente_permissoes")
}

/// userId nulo = regra da empresa (Master); senão, regra pessoal.
model AssistenteRegra {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  nome      String
  texto     String
  ativo     Boolean  @default(true)
  bloqueia  Json     @default("[]") // nomes de ferramentas que o servidor recusa
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("assistente_regras")
}

model AssistenteMemoria {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  texto     String
  origem    String   @default("usuario") // 'usuario' | 'assistente'
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("assistente_memorias")
}

/// Atalhos do chat.
model AssistentePergunta {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  texto     String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("assistente_perguntas")
}

/// Chamadas de ferramenta (retenção de 90 dias, limpeza na consulta).
model AssistenteAuditoria {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id") @db.Uuid
  ferramenta String
  argumentos String?
  resultado  String?
  bloqueada  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@map("assistente_auditoria")
}
