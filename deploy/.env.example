# Copie para deploy/.env (na VM: /opt/sondohub/.env) e preencha. O .env NUNCA vai para o git.
# Valor com $ precisa de aspas simples: o Docker Compose trata $ como variável.

# ── Endereço público do hub: é o "iss" do JWT e o hubUrl de todos os apps (sem / no fim) ──
HUB_URL=https://hub.sondotecnica.com

# ── Banco (Azure). Senha CODIFICADA: [uri]::EscapeDataString('<senha>') ──
DATABASE_URL=postgresql://<usuario>:<senha-codificada>@serverdb-flex-qgis.postgres.database.azure.com:5432/<banco>?schema=sondohub&sslmode=require&connection_limit=5

# ── Sessão: em produção o cookie é __Host- e só trafega em HTTPS ──
SESSION_COOKIE_NAME=__Host-sondohub_session
COOKIE_SECURE=true

# ── JWT: chave NOVA, só de produção:  node apps/api/scripts/generate-jwt-key.ts ──
JWT_KEY_ID=
JWT_PRIVATE_KEY=

# ── Avatares ──
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
